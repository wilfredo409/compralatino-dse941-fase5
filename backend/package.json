{
  "name": "compralatino-backend",
  "version": "1.0.0",
  "description": "CompraLatino — API REST (Fase 3, DSE941). Backend Node.js + Express sobre el contrato openapi.yaml y el esquema schema.sql de Fase 2.",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node db/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=80 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}

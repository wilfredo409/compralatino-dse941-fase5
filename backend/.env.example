# Copiar a .env y ajustar para cada entorno.

# Base de datos (Fase 3 usa el mismo schema.sql de Fase 2, PostgreSQL 16 — ADR-04)
DATABASE_URL=postgres://compralatino:compralatino_dev@localhost:5432/compralatino

# JWT (M1 · Cuentas)
JWT_SECRET=cambiar-en-produccion-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=900          # 15 min, en segundos
JWT_REFRESH_EXPIRES_IN=1209600  # 14 días, en segundos

# Servidor
PORT=3000
CORS_ALLOWED_ORIGINS=

# Webhook de pagos (firma HMAC, ver supuestos_fase3.md #6)
WEBHOOK_SECRET=cambiar-en-produccion

# YAuctionsAdapter (mock — no existe acceso real a YAuctions, ver supuestos_fase3.md #7)
YAUCTIONS_LATENCY_MS_MIN=150
YAUCTIONS_LATENCY_MS_MAX=900
YAUCTIONS_FAILURE_RATE=0        # 0.0–1.0; súbelo (p.ej. 0.9) para forzar fallos y ver el Circuit Breaker abrirse en la demo
YAUCTIONS_BREAKER_THRESHOLD=5   # fallos consecutivos para abrir el circuito
YAUCTIONS_BREAKER_COOLDOWN_MS=30000

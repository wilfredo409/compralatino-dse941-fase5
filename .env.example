# Copiar a .env (en el mismo directorio que docker-compose.yml) y cambiar los tres secretos.
# Generar uno aleatorio:  openssl rand -hex 24
DB_PASSWORD=cambiar-por-una-clave-larga
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
WEBHOOK_SECRET=cambiar-por-otro-secreto

# 0 = YAuctions simulado siempre responde bien. Súbelo (0.9) para forzar el Circuit Breaker en la demo.
YAUCTIONS_FAILURE_RATE=0
